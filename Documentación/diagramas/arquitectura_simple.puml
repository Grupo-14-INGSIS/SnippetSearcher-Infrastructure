@startuml
' Vista simple: los 4 servicios, sus bases y con quién habla cada uno, por capas.
' Basado en el uml_graph original (dic. 2025), actualizado a la arquitectura actual.
' Generar la imagen: java -jar plantuml.jar -tpng -Playout=smetana arquitectura_simple.puml
left to right direction
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam roundCorner 10
skinparam ArrowColor #444444
skinparam rectangle {
  BackgroundColor #F4F6FA
  BorderColor #5B6B82
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #5B6B82
}

actor "Usuario\n(navegador)" as user
cloud "Auth0" as auth0

rectangle "nginx\nentrada única (HTTPS)" as nginx

rectangle "UI\n(React)" as ui
rectangle "App\nAPI pública y lógica" as app
rectangle "AccessManager\npermisos" as am
rectangle "Runner\nejecuta, formatea, lintea" as runner

queue "Redis Streams\ncola de trabajos" as redis
rectangle "asset-service" as asset

database "appdb\nsnippets, tests, usuarios" as appdb
database "accessmanager-db\ndueños y compartidos" as amdb
database "runner-db\nreglas" as rdb
database "Azurite\ncódigo de los snippets" as az

user --> auth0 : login
user --> nginx
nginx --> ui : /
nginx --> app : /api
app ..> auth0 : valida tokens

app --> am : ¿puede?
app --> runner : guardar código, ejecutar,\ntests, reglas

app --> redis
redis --> runner : trabajos
runner --> redis : resultados

am --> amdb
app --> appdb
runner --> rdb
runner --> asset
asset --> az
@enduml
