[Unit]
Description=SnippetSearcher: traer ultima version del stack e imagenes al prender la VM
# Espera a que haya red y a que docker (y el swarm) esten levantados
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=azureuser
Environment=HOME=/home/azureuser
WorkingDirectory=/home/azureuser
ExecStart=/usr/bin/bash /home/azureuser/boot-deploy.sh
# El stack deploy + pull de imagenes puede tardar unos minutos
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
